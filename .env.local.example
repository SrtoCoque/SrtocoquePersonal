# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Nunca pongas la secret / service_role en variables NEXT_PUBLIC_*

# Google Books API
GOOGLE_BOOKS_API_KEY=tu-api-key-de-google

# IGDB (videojuegos) vía Twitch — https://dev.twitch.tv/console
# 1) Cuenta Twitch + 2FA
# 2) Register Your Application → Client Type: Confidential
# 3) OAuth Redirect URL: http://localhost
# 4) Generate Client Secret
IGDB_CLIENT_ID=tu-client-id-de-twitch
IGDB_CLIENT_SECRET=tu-client-secret-de-twitch

# TMDB Movies API — https://www.themoviedb.org/settings/api
TMDB_API_KEY=tu-api-key-de-tmdb

# Comic Vine (cómics) — https://comicvine.gamespot.com/api/
# Requiere cuenta gratuita; la API exige un User-Agent propio en cada petición.
COMICVINE_API_KEY=tu-api-key-de-comic-vine

# Steam Web API — https://steamcommunity.com/dev/apikey
# Perfil de juegos público. Vinculas pegando la URL del perfil / vanity / SteamID64.
STEAM_WEB_API_KEY=tu-steam-web-api-key

# Cron diario Steam (Vercel Cron → Authorization: Bearer …)
# En Vercel: Project → Settings → Environment Variables
# SUPABASE_SERVICE_ROLE_KEY = Project Settings → API → service_role (secreta)
# CRON_SECRET = cadena larga aleatoria (Vercel la inyecta en crons si la defines)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
CRON_SECRET=genera-una-cadena-larga-aleatoria
