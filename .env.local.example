# Supabase — Project Settings → API
# URL: https://<project-ref>.supabase.co
# Clave: anon (JWT) o publishable (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# Nunca pongas la secret / service_role en variables NEXT_PUBLIC_*

# Google Books API (obligatoria — crea la clave en Google Cloud Console)
GOOGLE_BOOKS_API_KEY=tu-api-key-de-google
